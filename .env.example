PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/languagenest
CLIENT_URL=https://language-nest-nu.vercel.app
ADMIN_URL=https://language-nest-pilot.vercel.app

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Language Nest <onboarding@resend.dev>

GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
